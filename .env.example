DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# Comma-separated channel IDs the bot watches
ALERT_CHANNEL_IDS=123456789012345678,234567890123456789
# Grafana base URL, a service account token (role: Viewer) and the Loki datasource UID
GRAFANA_URL=http://grafana:3000
GRAFANA_TOKEN=
LOKI_DATASOURCE_UID=
CLAUDE_MODEL=claude-sonnet-4-5
# Set to true to ignore bot/webhook messages (you probably want false)
IGNORE_BOTS=false
